{
  "name": "@xflip/playground",
  "version": "0.0.0",
  "private": true,
  "description": "Interactive demo app for @xflip/react",
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @xflip/core build",
    "dev": "vite",
    "prebuild": "pnpm --filter @xflip/core build",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "fixtures": "pnpm --filter @xflip/core build && node scripts/build-fixtures.mjs",
    "gacha": "pnpm --filter @xflip/core build && node scripts/build-gacha.mjs",
    "encode-pack": "pnpm --filter @xflip/core build && node scripts/encode-pack.mjs",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@xflip/core": "workspace:*",
    "@xflip/react": "workspace:*",
    "@xflip/viewer": "workspace:*",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "sharp": "^0.34.5",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
