# Copy to .env on the server. Required in production.
XFLIP_JWT_SECRET=change-me-to-a-long-random-string
PORT=8787
NODE_ENV=production
# SQLite file path (created if missing). Use an absolute path on the VPS.
XFLIP_DB_PATH=data/xflip.db
# Served static client build (relative to apps/server when running dist/).
XFLIP_STATIC_ROOT=../playground/dist
