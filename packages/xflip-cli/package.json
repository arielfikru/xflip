{
  "name": "@xflip/cli",
  "version": "0.0.0",
  "description": "Command-line tool for creating, inspecting, extracting xflip image files",
  "license": "MIT",
  "author": "arielfikru <arielfikrua@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/arielfikru/xflip.git",
    "directory": "packages/xflip-cli"
  },
  "homepage": "https://github.com/arielfikru/xflip/tree/main/packages/xflip-cli#readme",
  "bugs": {
    "url": "https://github.com/arielfikru/xflip/issues"
  },
  "keywords": [
    "xflip",
    "cli",
    "image",
    "format",
    "trading-card",
    "holographic"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "xflip": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "clean": "rm -rf dist coverage *.tsbuildinfo"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@xflip/core": "workspace:*"
  }
}
