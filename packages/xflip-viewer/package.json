{
  "name": "@xflip/viewer",
  "version": "0.0.0",
  "description": "Web Component <xflip-card> for rendering xflip image files (shadow DOM, zero framework dependencies)",
  "license": "MIT",
  "author": "arielfikru <arielfikrua@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/arielfikru/xflip.git",
    "directory": "packages/xflip-viewer"
  },
  "homepage": "https://github.com/arielfikru/xflip/tree/main/packages/xflip-viewer#readme",
  "bugs": {
    "url": "https://github.com/arielfikru/xflip/issues"
  },
  "keywords": [
    "xflip",
    "web-component",
    "custom-element",
    "trading-card",
    "holographic",
    "viewer"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/define.js",
    "./src/define.ts"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./define": {
      "types": "./dist/define.d.ts",
      "import": "./dist/define.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium firefox webkit",
    "clean": "rm -rf dist coverage *.tsbuildinfo playwright-report test-results"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@xflip/core": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "happy-dom": "^15.11.0",
    "vite": "^5.4.0",
    "vite-plugin-dts": "^4.3.0"
  }
}
